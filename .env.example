# Website origin and Auth.js secret. Existing JWT sessions must sign in again.
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-random-secret
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Server-only credential scoped to website accounts and sessions in CookieAPI.
COOKIECAPES_API_URL=http://127.0.0.1:8000
# Public API origin for cape listings/images. Contains no credentials. Restart Next.js after changing.
NEXT_PUBLIC_COOKIECAPES_API_URL=http://127.0.0.1:8000
WEBSITE_SERVICE_TOKEN=
# Preserve existing administrator Discord IDs after internal user IDs are enabled.
ADMIN_DISCORD_IDS=
# Existing unrelated homepage registration / moderation credentials, if used.
COOKIEATTACK_BACKEND_KEY=
COOKIECAPES_API_TOKEN=
